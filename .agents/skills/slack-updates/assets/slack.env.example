# Local settings for the slack-updates skill.
#
# Copy this file to ~/.config/sample-eks-nitro-sandbox/slack.env and fill it in with the
# values a maintainer gives you. They belong to your Slack workspace, so they never go in
# the repository. Each line is KEY=value; nothing in it is run as a shell command.

# The maintainers' channel: its name, for people, and its ID, which the commands use.
SLACK_CHANNEL_NAME=
SLACK_CHANNEL_ID=

# Leave this empty: posts mention nobody.
SLACK_PEOPLE=

# The command that posts, in your Slack command-line tool. post.py replaces {channel},
# {text} (the one-line message) and {blocks} (Block Kit JSON), each as one argument.
SLACK_POST_COMMAND=

# The command that prints the channel's newest message as JSON. post.py replaces
# {channel}, and looks for the new message's ts in what it prints.
SLACK_HISTORY_COMMAND=
