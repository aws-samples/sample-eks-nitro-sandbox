# Copy to .env and fill in, or let ./scripts/setup.sh write it for you.
# .env is gitignored: it holds IDs and addresses from your own account and cluster.
#
# The two you set before the first run:
export CLUSTER_NAME=<your-cluster>
export AWS_REGION=us-west-2
#
# The rest are written by ./scripts/setup.sh after it creates the resources:
# export NAMESPACE=nitro-efs-sample
# export RESOURCE_PREFIX=storage-efs-<your-cluster>
# export EFS_FILE_SYSTEM_ID=fs-xxxxxxxxxxxxxxxxx
# export EFS_ACCESS_POINT_ID=fsap-xxxxxxxxxxxxxxxxx
# export EFS_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
# export EFS_CSI_NODE_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/<efs-csi-node-role>
# export CREATED_SECURITY_GROUP=true
# export COREDNS_IP=10.100.0.10
# export MOUNT_TARGET_IPS=10.0.1.10 10.0.2.10 10.0.3.10
