<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device">
  <diagram id="efs-shared-storage" name="Diagram">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1000" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- AWS Cloud frame -->
        <mxCell id="cloud" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;AWS Cloud&lt;/div&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;grStroke=1;grIconSize=48;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=62;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="2000" height="920" as="geometry" />
        </mxCell>

        <!-- EKS cluster frame -->
        <mxCell id="cluster" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Amazon EKS cluster&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#ED7100;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=62;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#ED7100;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="880" height="760" as="geometry" />
        </mxCell>
        <mxCell id="tab-cluster" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- Writer Nitro sandbox frame -->
        <mxCell id="sandbox-writer" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Nitro sandbox&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:22px&quot;&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;lightweight VM, its own kernel&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#DD344C;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=62;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#DD344C;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="120" y="200" width="400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="tab-sandbox-writer" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1">
          <mxGeometry x="120" y="200" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- Writer pod box -->
        <mxCell id="pod-writer" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Writer&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:22px&quot;&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;isolated-sandbox&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="160" y="280" width="320" height="180" as="geometry" />
        </mxCell>

        <!-- Writer containers -->
        <mxCell id="writer-container" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;/shared mounted&lt;/div&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="280" y="340" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Reader Nitro sandbox frame -->
        <mxCell id="sandbox-reader" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Nitro sandbox&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:22px&quot;&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;lightweight VM, its own kernel&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#DD344C;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=62;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#DD344C;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="120" y="540" width="400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="tab-sandbox-reader" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1">
          <mxGeometry x="120" y="540" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- Reader pod box -->
        <mxCell id="pod-reader" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Reader&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:22px&quot;&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;isolated-sandbox&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="160" y="620" width="320" height="180" as="geometry" />
        </mxCell>

        <!-- Reader containers -->
        <mxCell id="reader-container" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;/shared mounted&lt;/div&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="280" y="680" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Security group box: wraps the file system mount target -->
        <mxCell id="sg-box" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Security group&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:22px&quot;&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;TCP 2049 from cluster&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1480" y="360" width="240" height="220" as="geometry" />
        </mxCell>

        <!-- Writer access point (top row, aligned with the writer pod) -->
        <mxCell id="writer-access-point" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;Writer access point&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;read-write, same root&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.general_access_points;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1120" y="240" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Reader access point (lower row, aligned with the reader pod) -->
        <mxCell id="reader-access-point" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;Reader access point&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;read-only, same root&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.general_access_points;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1120" y="620" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- S3 Files mount target (one file system behind both access points) -->
        <mxCell id="mount-target" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;S3 Files file system&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;one mount target&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_database;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1560" y="420" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Amazon S3 versioned bucket -->
        <mxCell id="bucket" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;Amazon S3&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;versioned bucket&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1880" y="420" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- CSI node role (below the resources, clear of the mount corridors) -->
        <mxCell id="csi-role" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;EFS CSI driver&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;node role signs the mount&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.role;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1120" y="800" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- File system policy note: keyed on the access point, one CSI role, two grants -->
        <mxCell id="fs-policy-note" value="&lt;div style=&quot;line-height:22px&quot;&gt;&lt;b&gt;File system policy&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height:22px&quot;&gt;one CSI node role: read-write through the&lt;/div&gt;&lt;div style=&quot;line-height:22px&quot;&gt;writer access point, read-only through the&lt;/div&gt;&lt;div style=&quot;line-height:22px&quot;&gt;reader access point, by s3files:AccessPointArn&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=16;fontColor=#5F6B7A;fontFamily=Arial,Helvetica,sans-serif;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1320" y="800" width="520" height="100" as="geometry" />
        </mxCell>

        <!-- Writer pod to writer access point: riser at x=1000 up to the top AP row -->
        <mxCell id="e-writer-ap" value="&lt;div style=&quot;line-height:22px&quot;&gt;&lt;b&gt;read-write&lt;/b&gt;&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;verticalAlign=bottom;" edge="1" parent="1" source="writer-container" target="writer-access-point">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="380" />
              <mxPoint x="1000" y="280" />
            </Array>
            <mxPoint x="0" y="-6" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Reader pod to reader access point: riser at x=1000 down to the bottom AP row -->
        <mxCell id="e-reader-ap" value="&lt;div style=&quot;line-height:22px&quot;&gt;&lt;b&gt;read-only&lt;/b&gt;&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;verticalAlign=top;" edge="1" parent="1" source="reader-container" target="reader-access-point">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="720" />
              <mxPoint x="1000" y="660" />
            </Array>
            <mxPoint x="0" y="6" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- One label for the shared mount flow, in the clear band between the two access points -->
        <mxCell id="mount-flow-label" value="&lt;div style=&quot;line-height:22px&quot;&gt;mount over &lt;b&gt;tls, iam&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height:22px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;signed by the CSI node role&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=18;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1090" y="450" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Writer access point to file system -->
        <mxCell id="e-writer-mount" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="writer-access-point" target="mount-target">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1400" y="280" />
              <mxPoint x="1400" y="444" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Reader access point to file system -->
        <mxCell id="e-reader-mount" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="reader-access-point" target="mount-target">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1400" y="660" />
              <mxPoint x="1400" y="476" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- File system to bucket: two-way synchronization -->
        <mxCell id="e-access-bucket" value="&lt;div style=&quot;line-height:22px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;sync&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=block;startFill=1;startSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;verticalAlign=bottom;" edge="1" parent="1" source="mount-target" target="bucket">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-18" as="offset" />
          </mxGeometry>
        </mxCell>


      </root>
    </mxGraphModel>
  </diagram>
