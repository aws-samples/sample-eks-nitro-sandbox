# Copy to .env and fill in, or let ./scripts/setup.sh write it for you.
# .env is gitignored: it holds IDs and addresses from your own account and cluster.
#
# The two you set before the first run:
export CLUSTER_NAME=<your-cluster>
export AWS_REGION=us-west-2
#
# The rest are written by ./scripts/setup.sh after it creates the resources:
# export NAMESPACE=nitro-s3-files-sample
# export RESOURCE_PREFIX=storage-s3-files-<your-cluster>
# export S3_BUCKET_NAME=storage-s3-files-<your-cluster>-<ACCOUNT_ID>-us-west-2
# export S3_FILES_FILE_SYSTEM_ID=fs-xxxxxxxxxxxxxxxxx
# export S3_FILES_ACCESS_POINT_ID=fsap-xxxxxxxxxxxxxxxxx
# export S3_FILES_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
# export S3_FILES_CSI_NODE_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/<efs-csi-node-role>
# export EC2_NODE_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/<ec2-node-role>
# export S3_FILES_SYNC_ROLE_NAME=storage-s3-files-<your-cluster>-sync
# export S3_FILES_SYNC_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/<sync-role>
# export CREATED_BUCKET=true
# export CREATED_SYNC_ROLE=true
# export CREATED_SECURITY_GROUP=true
# export MOUNT_TARGET_IPS=<MOUNT_TARGET_IP_1> <MOUNT_TARGET_IP_2> <MOUNT_TARGET_IP_3>
