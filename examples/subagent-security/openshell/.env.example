# Copy this file to .env and fill it in. .env is gitignored: nothing from your own
# account or cluster belongs in a tracked file.
#
#   cp .env.example .env && $EDITOR .env

# Your cluster's name, and the Region it is in.
CLUSTER_NAME=
AWS_REGION=us-west-2

# The kube context to pin every kubectl call to. Leave it empty to use the current
# context. Set it on a shared machine, where another session can change the current one
# in the middle of a run.
KUBE_CONTEXT=

# The namespace this sample creates and owns. Change it to run this sample twice, or
# beside another demo; it reaches every object the scripts apply, including the admission
# adapter's namespace selector.
NAMESPACE=subagent-security-openshell

# The Amazon Bedrock inference profile the model bridge calls. The run on the page used
# this one. The bridge's IAM role is scoped to whichever profile you name here.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional. Left empty, setup.sh names the bucket and the bridge's role for this sample
# and your account id. Set them to run a second copy beside the first.
# BUCKET=
# ROLE_NAME=
