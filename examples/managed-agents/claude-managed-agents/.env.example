# Copy to .env (git ignores it) and fill in. Never commit the real file.

# Your organization API key. Used only on this machine, by scripts/, to create
# the agent and environment and to start sessions. It is never put in the cluster.
ANTHROPIC_API_KEY=

# Printed by scripts/setup_agent.py.
AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=

# Generated in the Claude Console: Workspace > Environments > your environment >
# Generate environment key. The only key the cluster gets.
ANTHROPIC_ENVIRONMENT_KEY=
