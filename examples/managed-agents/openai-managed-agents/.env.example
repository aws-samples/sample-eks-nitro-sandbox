# Copy to .env (git ignores it) and fill in. Never commit the real file.

# Your application key. Used ONLY on this machine, by scripts/, to create the
# agent, create and read sessions, and delete them. It is never put in the
# cluster: no launcher pod and no sandbox pod holds it.
OPENAI_API_KEY=

# The environment key. codex exec-server reads it as CODEX_API_KEY to connect
# its environment. This is the ONLY key the cluster gets: the launcher holds it
# and gives it to each claimed sandbox through the SandboxClaim env (the
# controller sets it on the claimed pod), so it never crosses the pod network.
#
# CREATE THIS KEY ON THE PROJECT'S AGENTS TAB, not the ordinary API keys page,
# and set every other permission on it to None. A key minted on the Agents tab
# carries the api.agents.environments.connect capability the executor needs; an
# ordinary project API key does NOT, even with "all permissions", and the
# executor would fail with "403 missing required scope
# api.agents.environments.connect". Both keys must share the same owner,
# organization and project. OpenAI documents no credential narrower than this
# for a self-hosted session, and agent-generated code can read it, so give each
# trust boundary its own OpenAI project (see the README, "The two keys").
OPENAI_EXECUTOR_API_KEY=

# The launcher intake's bearer token. The launcher authenticates every request
# with it, and refuses to start without it. Store the SAME value in the
# launcher-auth Secret (see the README). Generate one with, e.g.,
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LAUNCHER_AUTH_TOKEN=

# Printed by scripts/setup_agent.py after it creates the agent.
AGENT_ID=

# Optional: the model id for the agent. setup_agent.py uses a PLACEHOLDER if
# unset; set a model id your project can use (confirm it at
# https://platform.openai.com/docs/models). Not an internal/runtime id.
AGENT_MODEL=

# Optional: an OpenAI API base URL override. Leave this commented out to use
# the SDK default; exporting an empty value is not the same as leaving it unset.
# OPENAI_BASE_URL=https://api.openai.com/v1
