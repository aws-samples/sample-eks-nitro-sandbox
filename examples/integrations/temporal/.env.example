# Copy to .env (git ignores it) and change what you need. The scripts read these,
# and a value already set in your environment wins over the file.
#
#   cp .env.example .env
#
# There are no secrets here. The Worker holds no model key, no API token and no
# Temporal credential, and the PostgreSQL password lives only in a Kubernetes
# Secret you create from standard input.

# The kube context for the cluster you ran Getting started on. Set it, so a run
# never depends on the machine's current context: on a shared cluster another
# session can change it.
KUBE_CONTEXT=

# The namespace the sample runs in. setup.sh creates it only when it is absent
# and labels it, so the clean up can tell it is the sample's.
NAMESPACE=temporal-sandboxes

# The Region the ECR repository for the Worker image lives in.
AWS_REGION=us-west-2

# The ECR repository setup.sh creates or reuses, tagged ManagedBy=temporal.
ECR_REPOSITORY=temporal-sandbox-worker

# Leave IMAGE_TAG unset: setup.sh derives the tag from every file under worker/,
# so a change to any of them produces a new tag.
# IMAGE_TAG=

# Leave STORAGE_CLASS unset to let setup choose the class for the sandbox's
# workspace: the cluster's default when exactly one fits (EBS CSI, gp3,
# encrypted), otherwise the sample's own class, created only when absent and
# removed by the clean up. Set it to force a specific class.
# STORAGE_CLASS=

# Where the Temporal server is, and the Helm release name it was installed
# under, which its Service names are derived from. Nothing in this sample
# installs, upgrades or reconfigures it.
TEMPORAL_K8S_NAMESPACE=temporal
TEMPORAL_RELEASE=temporal

# The Temporal namespace the runs land in. The server's install creates it; the
# sample's scripts only check that it is there.
TEMPORAL_NAMESPACE=nitro-sandbox

# The task queue the Worker polls and the starter targets.
TASK_QUEUE=nitro-sandbox-lifecycle

# The Sandbox the workflow drives. One at a time: the workflow id is fixed per
# sandbox name, so the server refuses a second start while a run is open.
SANDBOX_NAME=lifecycle

# How long a run waits with the sandbox suspended. This is the window the page
# uses to delete the Worker pod and show the run carry on.
SUSPENDED_SECONDS=120
