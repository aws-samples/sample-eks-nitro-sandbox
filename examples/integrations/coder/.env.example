# Copy to .env (git ignores it) and change what you need. The scripts read these names.
#
#   cp .env.example .env
#
# A value already set in your environment wins over this file. The file is read
# literally: write NAME=value, with no quotes and no comment after the value.

# The EKS Auto Mode cluster you ran Getting started on, and its Region.
CLUSTER_NAME=sandbox-demo
AWS_REGION=us-west-2

# The kube context for that cluster. Leave it empty to use the current context. Either way
# setup and clean up stop unless the context's API server is this cluster's.
KUBE_CONTEXT=

# Coder, Keycloak and PostgreSQL run in NAMESPACE; the workspace pods and their home volumes
# in WORKSPACE_NAMESPACE. Setup creates both, labelled app.kubernetes.io/part-of=coder, and
# stops if one exists without that label.
NAMESPACE=coder
WORKSPACE_NAMESPACE=coder-workspaces

# The Amazon Bedrock inference profile Claude Code uses in the workspaces. The workspace
# IAM role may invoke only this profile and the foundation models it routes to.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5

# How many developer users setup creates in Keycloak (dev1 to devN), besides admin.
DEVELOPER_COUNT=2

# Where the generated passwords, users.txt and the template variables file are written.
# The default is the repository's tmp/coder, which git ignores.
# LOCAL_DIR=
