# Copy to .env (git ignores it) and fill in. Never commit the real file.
# scripts/setup.sh, scripts/changed-pod.sh and scripts/clean.sh read it.

# The EKS cluster to run on, and the Region. The cluster must have the
# confidential-sandbox runtime class (see the Getting started samples) and network policy
# enforcement turned on (the page has the one-line cluster change).
CLUSTER_NAME=sandbox-demo
AWS_REGION=us-west-2

# The kube context to use, so a run on a shared machine cannot be redirected by another
# session. Leave empty to use whatever context is current.
#   kubectl config get-contexts
KUBE_CONTEXT=

# The bucket the encrypted file is uploaded to. There is no default, because an S3 bucket
# name is global: pick one nobody has taken, and remember that a name stays unavailable for
# a while after the bucket is deleted, so a second run after a clean up may need a new one.
# setup.sh creates it private and encrypted, tags it ManagedBy=s3-encrypted-file, and
# reuses it on a later run only when it carries that tag.
S3_BUCKET=

# The namespace the sample creates, and the names it gives its other AWS resources. Change
# them if something in your account already owns a name. Every AWS resource is tagged
# ManagedBy=s3-encrypted-file, and setup.sh reuses one only when it carries that tag.
NAMESPACE=s3-encrypted-file-sample
ECR_REPOSITORY=s3-encrypted-file-sample
KMS_ALIAS=alias/s3-encrypted-file-sample
IAM_ROLE_NAME=s3-encrypted-file-sample-pod

# The size of the file the setup machine encrypts, in bytes. The default is 100 KiB, which
# is well past the 4 KiB that AWS KMS will encrypt directly: that difference is why the
# sample wraps a data key rather than handing the file to KMS.
#FILE_SIZE_BYTES=102400

# The Cedar policy generator the Amazon EKS User Guide, "Cedar policies", names. Set this
# only if your copy is named or located differently from the name the guide uses.
#GENPOLICY=eks-nitro-sandbox-genpolicy

# The container tool that builds the application image, and runs the encrypt helper on the
# setup machine. Set it to finch or podman if you do not use docker.
#CONTAINER_CLI=docker
