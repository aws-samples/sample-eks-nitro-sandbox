# Copy to .env (git ignores it) and fill in. Never commit the real file.
# scripts/setup.sh, scripts/new-version.sh, scripts/pinned-arm.sh and scripts/clean.sh
# read it.

# The EKS cluster to run on, and the Region. The cluster must have the
# confidential-sandbox runtime class (see the Getting started samples).
CLUSTER_NAME=sandbox-demo
AWS_REGION=us-west-2

# The AWS Signer signing profile name. Leave the default for a first run. If you run
# clean.sh --delete-aws-resources (which CANCELS the profile) and then set up again,
# change this to a NEW name: AWS Signer keeps a canceled profile until its signatures
# expire (about 141 months) and refuses to reuse the name.
SIGNING_PROFILE=nitro_sample_trusted_release

# The provider's two releases. scripts/setup.sh builds, pushes and signs the first;
# scripts/new-version.sh does the same for the second. Each becomes an image tag, and the
# repository is created with IMMUTABLE tags, so to run the sample again without deleting
# the repository, set two release names it does not already hold.
RELEASE_ONE=1.0.0
RELEASE_TWO=1.1.0
