# Copy to .env (git ignores it) and fill in. Never commit the real file.
# scripts/setup.sh, scripts/changed-pod.sh and scripts/clean.sh read it.

# The EKS cluster to run on, and the Region. The cluster must have the
# confidential-sandbox runtime class (see the Getting started samples) and network policy
# enforcement turned on (the page has the one-line cluster change).
CLUSTER_NAME=sandbox-demo
AWS_REGION=us-west-2

# The kube context to use, so a run on a shared machine cannot be redirected by another
# session. Leave empty to use whatever context is current.
#   kubectl config get-contexts
KUBE_CONTEXT=

# The namespace the sample creates, and the names it gives its AWS resources. Change them
# if something in your account already owns a name. All five AWS resources are tagged
# ManagedBy=secrets-manager-secret, and setup.sh reuses one only when it carries that tag.
NAMESPACE=secrets-manager-secret-sample
ECR_REPOSITORY=secrets-manager-secret-sample
KMS_ALIAS=alias/secrets-manager-secret-sample
IAM_ROLE_NAME=secrets-manager-secret-sample-pod

# The name of the secret. This one is worth a word of its own: a Secrets Manager name stays
# taken for a while after the secret is deleted, because deletion is asynchronous even when
# it is immediate. clean.sh deletes the secret with no recovery window, so the name does
# come back, but if a run stops with "a secret with this name already exists" and the
# previous one is gone, give this a new value rather than waiting.
SECRET_NAME=secrets-manager-secret-sample

# The Cedar policy generator the Amazon EKS User Guide, "Cedar policies", names. Set this
# only if your copy is named or located differently from the name the guide uses.
#GENPOLICY=eks-nitro-sandbox-genpolicy

# The container runtime used to build the application image. Set it to finch or podman if
# you do not use docker.
#CONTAINER_CLI=docker
