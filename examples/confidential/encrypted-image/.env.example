# Copy to .env (git ignores it) and fill in. Never commit the real file.
# scripts/setup.sh, scripts/changed-pod.sh and scripts/clean.sh read it.

# The EKS cluster to run on, and the Region. The cluster must have the
# confidential-sandbox runtime class (see the Getting started samples) and network
# policy enforcement turned on (the page has the one-line cluster change).
CLUSTER_NAME=sandbox-demo
AWS_REGION=us-west-2

# The kube context to use, so a run on a shared machine cannot be redirected by
# another session. Leave empty to use whatever context is current.
#   kubectl config get-contexts
KUBE_CONTEXT=

# The namespace the sample creates, and the names it gives its AWS resources. Change
# them if something in your account already owns a name. All four AWS resources are
# tagged ManagedBy=encrypted-image, and setup.sh reuses one only when it carries that tag.
NAMESPACE=encrypted-image-sample
ECR_REPOSITORY=encrypted-image-sample
KMS_ALIAS=alias/encrypted-image-sample
IAM_ROLE_NAME=encrypted-image-sample-pod

# The plaintext image whose layers get encrypted. Any image works; this is a stock
# public base image with a shell and curl, and no AWS or KMS code of its own, which is
# what lets the page show that decryption belongs to the guest and not to your image.
SOURCE_IMAGE=public.ecr.aws/amazonlinux/amazonlinux:minimal

# The two build-machine tools from the Amazon EKS User Guide, "Encrypted container
# images" and "Cedar policies". Set these only if your copies are named or located
# differently from the names the guide uses.
#GENPOLICY=eks-nitro-sandbox-genpolicy
#KEYPROVIDER=nitro-sandbox-keyprovider

# skopeo runs in a container, so you do not need it installed on the build machine.
# Set CONTAINER_CLI to finch or podman if you do not use docker.
#CONTAINER_CLI=docker
#SKOPEO_IMAGE=quay.io/skopeo/stable:v1.20.0
