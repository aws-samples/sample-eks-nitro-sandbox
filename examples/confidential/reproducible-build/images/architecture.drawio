<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device">
  <diagram id="architecture" name="Diagram">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="0" tooltips="1" connect="0" arrows="0" fold="0" page="0" pageScale="1" pageWidth="2400" pageHeight="960" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- AWS Cloud frame 1 (ECR) -->
        <mxCell id="cloud1" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;AWS Cloud&lt;/div&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;grStroke=1;grIconSize=48;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=62;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="580" y="100" width="200" height="440" as="geometry" />
        </mxCell>

        <!-- AWS Cloud frame 2 (KMS + EKS) -->
        <mxCell id="cloud2" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;AWS Cloud&lt;/div&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;grStroke=1;grIconSize=48;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=62;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1040" y="100" width="1180" height="860" as="geometry" />
        </mxCell>

        <!-- Amazon EKS cluster frame (inside cloud2) -->
        <mxCell id="eks" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Amazon EKS cluster&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#ED7100;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=62;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#ED7100;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1300" y="160" width="880" height="760" as="geometry" />
        </mxCell>
        <mxCell id="eks-tab" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="1">
          <mxGeometry x="1300" y="160" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- Nitro sandbox pod frame (inside EKS) -->
        <mxCell id="sandbox" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Nitro sandbox pod&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:22px&quot;&gt;&lt;span style=&quot;font-weight:normal;color:#5F6B7A&quot;&gt;confidential-sandbox&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#DD344C;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=62;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#DD344C;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1360" y="250" width="780" height="630" as="geometry" />
        </mxCell>
        <mxCell id="sandbox-tab" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1">
          <mxGeometry x="1360" y="250" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- Source (outside AWS) -->
        <mxCell id="source" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;Source&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i style=&quot;color:#5F6B7A&quot;&gt;flake.nix, Cargo.lock&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_application;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- nixos/nix build (outside AWS) -->
        <mxCell id="nixbuild" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;nixos/nix build&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i style=&quot;color:#5F6B7A&quot;&gt;--platform linux/amd64&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Amazon ECR (inside cloud1) -->
        <mxCell id="ecr" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;Amazon ECR&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i style=&quot;color:#5F6B7A&quot;&gt;image digest&lt;/i&gt;&lt;/div&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="640" y="240" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Policy generator (outside AWS, between clouds) -->
        <mxCell id="generator" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;Policy generator&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i style=&quot;color:#5F6B7A&quot;&gt;predicts PCR17&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_application;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="880" y="240" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- AWS KMS (inside cloud2) -->
        <mxCell id="kms" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;AWS KMS&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i style=&quot;color:#5F6B7A&quot;&gt;gates on PCR17&lt;/i&gt;&lt;/div&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1160" y="240" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Decrypt service (inside sandbox) -->
        <mxCell id="decrypt" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;Decrypt service&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i style=&quot;color:#5F6B7A&quot;&gt;PUT /decrypt&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_application;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1700" y="460" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Verifier (outside AWS, row 2) -->
        <mxCell id="verifier" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;Verifier&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i style=&quot;color:#5F6B7A&quot;&gt;independent rebuild&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- nixos/nix rebuild (outside AWS, row 2) -->
        <mxCell id="nixrebuild" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;nixos/nix build&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i style=&quot;color:#5F6B7A&quot;&gt;fresh empty store&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="320" y="600" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Setup path (solid arrows) -->

        <!-- 1. Source -> nixos/nix build -->
        <mxCell id="e-src-nix" value="1. build" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="source" target="nixbuild">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 2. nixos/nix build -> ECR -->
        <mxCell id="e-nix-ecr" value="2. push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="nixbuild" target="ecr">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 3. ECR -> Generator -->
        <mxCell id="e-ecr-gen" value="3. image digest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="ecr" target="generator">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-100" y="-100" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 4. Generator -> KMS (set PCR17 condition) -->
        <mxCell id="e-gen-kms" value="4. set PCR17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="generator" target="kms">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 5. KMS -> Decrypt service (releases key on match) -->
        <mxCell id="e-kms-decrypt" value="5. key released on match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="kms" target="decrypt">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="280" />
              <mxPoint x="1300" y="440" />
              <mxPoint x="1740" y="440" />
            </Array>
            <mxPoint x="50" y="-40" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Verify path (dashed arrows) -->

        <!-- 6. Verifier -> nixos/nix rebuild -->
        <mxCell id="e-ver-reb" value="6. rebuild" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2;dashed=1;dashPattern=8 6;fixDash=1;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="verifier" target="nixrebuild">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 7. nixos/nix rebuild -> ECR (compare digest) -->
        <mxCell id="e-reb-ecr" value="7. compare digest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2;dashed=1;dashPattern=8 6;fixDash=1;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="nixrebuild" target="ecr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="570" y="620" />
              <mxPoint x="570" y="200" />
              <mxPoint x="680" y="200" />
            </Array>
            <mxPoint x="-80" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 8. nixos/nix rebuild -> KMS (predict PCR17 matches) -->
        <mxCell id="e-reb-kms" value="8. predict PCR17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2;dashed=1;dashPattern=8 6;fixDash=1;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="nixrebuild" target="kms">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="660" />
              <mxPoint x="1300" y="220" />
              <mxPoint x="1200" y="220" />
            </Array>
            <mxPoint x="0" y="-40" as="offset" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
