AWS_REGION=us-west-2
CLUSTER_NAME=sandbox-demo
KUBE_CONTEXT=
NAMESPACE=reproducible-build
REPO_NAME=reproducible-build
ROLE_NAME=reproducible-build-pod
GENPOLICY=eks-nitro-sandbox-genpolicy
CONTAINER_RUNTIME=docker
KMS_ALIAS=alias/reproducible-build-sample
# The debug stage's separate key (scripts/debug.sh). Must differ from KMS_ALIAS.
DEBUG_KMS_ALIAS=alias/reproducible-build-debug
# On macOS, run the Linux generator in a container (absolute paths):
# GENPOLICY=/path/to/examples/confidential/reproducible-build/scripts/genpolicy-container.sh
# GENPOLICY_BIN=/path/to/eks-nitro-sandbox-genpolicy
# The container runs linux/amd64; set this for a linux/arm64 generator binary:
# GENPOLICY_PLATFORM=linux/arm64
