# Copy to .env and edit if your cluster's context or names differ from the page's.
# cp .env.example .env

# The kube context to use. Leave empty to use whatever "kubectl config
# current-context" already points at -- check it before you run anything.
KUBE_CONTEXT=

# Names this sample creates. Change them only if they collide with something already
# on your cluster.
# The gateway and its sandboxes both run here.
GATEWAY_NAMESPACE=openshell-kubernetes
CREDENTIAL_NAMESPACE=openshell-kubernetes-credentials
GATEWAY_RELEASE=openshell

# The StorageClass for workspace PVCs. Leave empty (the default) to let setup choose:
# the cluster's default class if exactly one fits (EBS CSI, gp3, encrypted, reclaimPolicy
# Delete), otherwise the sample's own class (openshell-kubernetes-gp3). Set it to force a
# specific class, which setup then checks for EBS CSI provisioner and reclaimPolicy Delete.
WORKSPACE_STORAGE_CLASS=

# The local port scripts/demo.sh expects "kubectl port-forward" to be bound to.
GATEWAY_PORT=8080
