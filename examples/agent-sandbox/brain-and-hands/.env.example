# Copy to .env (git ignores it) and fill in your own values. The scripts read
# these.
#
#   cp .env.example .env

# Your EKS cluster and its Region. The Pod Identity association is created on
# this cluster, and the brain calls Amazon Bedrock and pulls its image from
# Amazon ECR in this Region.
CLUSTER_NAME=
AWS_REGION=us-west-2

# The kube context of the cluster above. Set it so a run never depends on the
# machine's current context, which on a shared machine another session can
# change mid-run. Leave it empty to use the current context; the scripts then
# print which one they used.
KUBE_CONTEXT=

# The namespace the sample runs in. setup.sh creates it, labels it so the other
# scripts can tell it is the sample's, and applies everything into it. Change it
# and every object the scripts apply follows.
#
# Keep the brain and the hands alone in this namespace. The brain's RBAC Role
# allows exec into any pod here, because the pods a warm pool hands out have
# generated names and RBAC selects by name.
NAMESPACE=brain-and-hands

# The Bedrock model the brain reasons with. List what your account has:
#   aws bedrock list-inference-profiles --region $AWS_REGION \
#     --query 'inferenceProfileSummaries[].inferenceProfileId'
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5

# The ECR repository for the brain image, and the IAM role the brain's
# ServiceAccount assumes through EKS Pod Identity. Both are named for the
# sample. Change them if those names are taken in your account.
ECR_REPOSITORY=brain-and-hands
POD_IDENTITY_ROLE_NAME=brain-and-hands-brain
