# Copy to .env (git ignores it) and change if you like. The scripts read these.
#
#   cp .env.example .env

# The namespace the sample runs in. The scripts create it (labeled so clean up
# can tell it is the sample's) and apply everything into it.
NAMESPACE=pause-resume

# Named only so clean up can confirm the EBS volume is gone against the right
# cluster and Region. These are the shared defaults from the home page; change
# them to match the cluster you ran Getting started on.
AWS_REGION=us-west-2
