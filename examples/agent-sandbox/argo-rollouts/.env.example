# Copy to .env (git ignores it) and change if you like. The scripts read these.
#
#   cp .env.example .env

# The namespace the sample runs in. setup.sh creates it, labelled so the other
# scripts can tell it is the sample's, and applies everything into it. Change it
# and every object the scripts apply follows, including the namespace the
# Rollout's plugin steps name in their config.
NAMESPACE=argo-rollouts-sample

# The kube context of the cluster you ran Getting started on. Set it so a run
# never depends on the machine's current context, which on a shared machine
# another session can change mid-run. Leave it empty to use the current context;
# the scripts then print which one they used.
KUBE_CONTEXT=

# Where Argo Rollouts is installed on your cluster. setup.sh and run-rollout.sh
# only READ this namespace, to check the controller is there and that the step
# plugin is registered. register-step-plugin.sh is the one script that writes to
# it, and only when you run it with `apply`. Change this if Argo Rollouts lives
# somewhere else on your cluster.
ARGO_NAMESPACE=argo-rollouts

# The Region the plugin image's ECR repository lives in. Only
# register-step-plugin.sh and `cleanup.sh --unregister` use it. The plugin binary
# has to come from a registry the CLUSTER can pull from, so the registration
# builds the image and pushes it to Amazon ECR in your own account.
AWS_REGION=us-west-2

# The name of that ECR repository. The registration creates it tagged
# ManagedBy=argo-rollouts, and reuses it only when it carries that tag, so it
# never pushes to a repository of the same name that belongs to something else.
# Change it if that name is taken in your account.
PLUGIN_REPO=nitro-sample-argo-rollouts-stepplugin
