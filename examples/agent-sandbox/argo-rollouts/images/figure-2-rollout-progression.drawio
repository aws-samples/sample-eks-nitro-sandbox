          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="&lt;div style=&quot;line-height:20px&quot;&gt;&lt;b&gt;The pool goes mixed, not uniformly stale:&lt;/b&gt; inside the window each claim takes a pod out, and the pool refills it from the template as it&lt;/div&gt;&lt;div style=&quot;line-height:20px&quot;&gt;now stands, so which revision a claim gets depends on which pod it is handed. The drain replaces them all. Every warm pod runs with&lt;/div&gt;&lt;div style=&quot;line-height:20px&quot;&gt;runtimeClassName: isolated-sandbox and has no network besides loopback.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#5F6B7A;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="1460" height="80" as="geometry" />
        </mxCell>
