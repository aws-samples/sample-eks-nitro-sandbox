# Copy to .env (git ignores it) and change if you like. The scripts read these.
#
#   cp .env.example .env

# The namespace the sample runs in. The scripts create it (labelled so clean up
# can tell it is the sample's) and apply everything into it.
NAMESPACE=ide

# The kube context of the cluster you ran Getting started on, so a run never
# depends on the machine's current context. Leave it empty to use the current one;
# the scripts print which cluster they used either way.
KUBE_CONTEXT=

# Leave STORAGE_CLASS unset to let setup choose the class: the cluster's default
# when exactly one fits (EBS CSI, gp3, encrypted), otherwise the sample's own
# class (created only when absent, removed by clean up). Set it to force a
# specific class; setup then checks that class uses the EBS CSI provisioner.
# STORAGE_CLASS=

# Where the editor's password and its argon2 hash are kept on your own machine.
# The default is the repository's tmp/ide, which git ignores. The plaintext never
# leaves this directory.
# LOCAL_DIR=

# The scripts read this file literally: no quotes are stripped, an inline
# "# comment" after a value becomes part of the value, and a line that starts
# with "export " is ignored. Write NAME=value and nothing else.
