# Copy to .env (git ignores it) and fill in. Never commit the real file.
# scripts/setup.sh and scripts/clean.sh read it.

# The EKS cluster to run on, and the Region. The cluster must have the
# isolated-sandbox runtime class (see the Getting started samples).
CLUSTER_NAME=sandbox-demo
AWS_REGION=us-west-2

# The AWS Signer signing profile name. Leave the default for a first run. If you
# run clean.sh --delete-aws-resources (which CANCELS the profile) and then set up
# again, change this to a NEW name: AWS Signer keeps a canceled profile until its
# signatures expire (about 141 months) and refuses to reuse the name.
SIGNING_PROFILE=nitro_sample_image_signing
