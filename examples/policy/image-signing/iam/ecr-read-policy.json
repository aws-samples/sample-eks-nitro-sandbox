{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPullSampleRepos",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": [
        "arn:aws:ecr:<AWS_REGION>:<ACCOUNT_ID>:repository/nitro-sample-image-signing-signed",
        "arn:aws:ecr:<AWS_REGION>:<ACCOUNT_ID>:repository/nitro-sample-image-signing-unsigned"
      ]
    }
  ]
}
