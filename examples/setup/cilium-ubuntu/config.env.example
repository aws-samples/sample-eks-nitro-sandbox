# Settings for the Cilium-on-Ubuntu sample. This file is TRACKED and holds placeholders only.
#
# Copy it to config.local.env (gitignored) and fill in the real values there:
#
#   cp config.env.example config.local.env
#
# setup.sh, test.sh and clean.sh source this file first and config.local.env second, so a
# value in config.local.env wins. Never put credentials in either file: the scripts use your
# default AWS profile, or the one named by AWS_PROFILE.

# The account and region the new, disposable cluster is created in. setup.sh refuses to run
# when the caller's account is not AWS_ACCOUNT_ID, so a wrong profile cannot build a cluster
# in the wrong place.
AWS_ACCOUNT_ID=""
AWS_REGION="us-west-2"

# The new cluster. Every other name (node groups, launch templates, IAM role) derives from it.
# This sample always creates a dedicated cluster; it never attaches to or modifies an existing
# one, because changing the CNI on a running cluster is unsafe.
CLUSTER_NAME="nitro-cilium-ubuntu"

# Two Availability Zones for the new VPC (EKS needs two). Both node groups run in the FIRST
# one. If a node group reports InsufficientInstanceCapacity, the error names the zones that
# have capacity; put one of those first.
AVAILABILITY_ZONES="us-west-2a us-west-2b"

# The Ubuntu 24.04 EKS Pod Isolation sandbox AMI built from the public Nitro Sandbox releases
# (scripts/common.sh names them) and BTF-validated by ../ubuntu-ami (issue #10's sample; its
# README says where its build records the AMI id). setup.sh verifies this AMI's architecture,
# owner and expected build metadata before it creates the sandbox node group; it never guesses
# or publishes an AMI id.
SANDBOX_AMI_ID=""

# The ManagedBy tag value ../ubuntu-ami's build wrote on SANDBOX_AMI_ID (its TAGS_OWNER_VALUE,
# default "ubuntu-ami-sample"). setup.sh's AMI preflight checks ManagedBy=<this value> as
# well as BtfValidated=true, since #10 only ever writes BtfValidated=true to an AMI that
# already carries its own ManagedBy tag. Leave this unset unless you built the AMI with a
# non-default RESOURCE_PREFIX in ../ubuntu-ami/config.env.
SANDBOX_AMI_MANAGED_BY_VALUE=""

# The standard public Ubuntu 24.04 LTS EKS-optimized AMI for the ordinary system node group.
# Record the exact AMI id you validated against (the README shows how to look one up from the
# AWS SSM public parameter for your Region and Kubernetes version); this sample does not
# resolve "latest" at runtime, so a re-run always boots the node you validated.
SYSTEM_AMI_ID=""

# The sandbox node's launch template turns Nitro Enclaves on (EnclaveOptions.Enabled=true),
# which is how each sandbox pod gets its own microVM, so SANDBOX_INSTANCE_TYPE must be a type
# that supports Nitro Enclaves. m8i.xlarge does; if it has no capacity, use another
# enclave-capable type such as m8i.2xlarge or m7i.xlarge. The .large sizes (m8i.large,
# m7i.large) do not support Nitro Enclaves. Check a type with:
#   aws ec2 describe-instance-types --instance-types <type> --query 'InstanceTypes[].NitroEnclavesSupport'
SANDBOX_INSTANCE_TYPE="m8i.xlarge"
# The ordinary system node has no such constraint.
SYSTEM_INSTANCE_TYPE="m7i.large"

# Optional extra tag for every resource, for example your team or alias.
OWNER_TAG=""
