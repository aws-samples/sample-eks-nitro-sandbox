{
  "name": "eks-nitro-sandbox-al2023",
  "description": "EKS-optimized AL2023 AMI with Nitro Sandbox runtime for pod isolation",
  "semanticVersion": "1.0.0",
  "parentImage": "arn:aws:imagebuilder:REGION:amazon:image/amazon-linux-2023-ecs-optimized-ami-kernel-6.1-x86/x.x.x",
  "components": [
    {
      "componentArn": "arn:aws:imagebuilder:REGION:ACCOUNT_ID:component/EKSNitroSandboxAL2023/x.x.x"
    }
  ],
  "blockDeviceMappings": [
    {
      "deviceName": "/dev/xvda",
      "ebs": {
        "deleteOnTermination": true,
        "volumeSize": 30,
        "volumeType": "gp3"
      }
    }
  ],
  "workingDirectory": "/tmp"
}
