# Local configuration for the al2023-ami blueprint. Copy to config.env (gitignored) and fill in
# real values there. Never commit config.env, and never put a real account ID, AMI ID, key,
# token, cluster/host name or internal URL in THIS file: it is tracked, placeholders only.
#
# Standard workstation environment (shared with the rest of this repository):
#   AWS_REGION, AWS_PROFILE, CLUSTER_NAME, and KUBE_CONTEXT, the kubectl context of that cluster.

# --- Cluster and placement -------------------------------------------------------------
# A STANDARD EKS cluster (not Auto Mode), Kubernetes 1.36 or 1.37. AWS_REGION and CLUSTER_NAME
# keep your shell's values; these defaults (the home page's) apply only when unset.
: "${AWS_REGION:=us-west-2}"; export AWS_REGION
: "${CLUSTER_NAME:=sandbox-demo}"; export CLUSTER_NAME
# Patch version used to resolve the guest-image S3 bundle path (e.g. 1.36.5 for 1.36, 1.37.1 for
# 1.37). The AMI build resolves the EKS base AMI from the standard SSM parameter for this minor.
export KUBERNETES_VERSION=1.36
# Required: the kubectl context of CLUSTER_NAME. Every kubectl call passes --context "$KUBE_CONTEXT";
# the scripts never fall back to the current context and never run `kubectl config use-context`.
export KUBE_CONTEXT="<your-context>"
# Existing private subnets in the cluster's VPC, with egress to package repositories, image
# registries, github.com, S3, SSM and EKS/EC2 APIs. This blueprint creates no network infrastructure.
export BUILD_SUBNET_ID=
# NODE_SUBNET_IDS: space-separated PRIVATE subnets with a NAT route. This matters: an EKS
# node gets no public IP by default, so a node launched into a public subnet cannot reach the
# EKS API to register and the node group hangs in CREATING with no instances. Use private
# subnets (the eksctl ones carry kubernetes.io/role/internal-elb=1), not public ones.
export NODE_SUBNET_IDS=""          # space-separated PRIVATE subnet ids
# The managed vpc-cni add-on version you installed as a prerequisite (see the README); the
# blueprint only checks the add-on is ACTIVE and records the version.
export VPC_CNI_ADDON_VERSION=

# --- Which consumer to run ---------------------------------------------------------------
# nodegroup | karpenter | both. The AMI is identical; this selects how nodes are launched.
export JOIN_MODE=both
# For the Karpenter path: the blueprint checks Karpenter is installed and reuses it as-is.
# Requires Karpenter v1.15.2 or later. Two features matter, at two versions:
#   - spec.enclaveOptions.enabled on the EC2NodeClass (enables Nitro Enclaves on Karpenter's
#     launch template): added in v1.15.1.
#   - the NodeOverlay that advertises eks.amazonaws.com/nitro-sandbox slot capacity so the
#     scheduler will provision for a sandbox pod (aws/karpenter-provider-aws#9904): v1.15.2.
# So the floor for the whole Karpenter path is v1.15.2. Install Karpenter with
# `--set settings.featureGates.nodeOverlay=true`.
export KARPENTER_VERSION=v1.15.2

# --- Ownership and naming ---------------------------------------------------------------
# Every AWS resource a run creates is named <RESOURCE_PREFIX>-<RUN_ID>-... and tagged
# ManagedBy=<RESOURCE_PREFIX> and RunId=<RUN_ID>. clean.sh deletes only what carries both tags.
export RESOURCE_PREFIX=al2023-ami
# The blueprint's own namespace (clean.sh deletes the namespace the run created, so it must be
# one only this blueprint uses).
export NAMESPACE=al2023-ami-sample

# --- Build host and node instance types --------------------------------------------------
# The build runs on an ENCLAVE-ENABLED builder: the upstream packer template does not enable
# Nitro Enclaves on the builder for you, so pass an enclave-capable instance type and ensure
# EnclaveOptions.Enabled=true on that build instance. m8i.4xlarge is enclave-capable and sized
# for the (short) assembly; the node instances also need an enclave-capable type.
export BUILD_INSTANCE_TYPE=m8i.4xlarge
export NODE_INSTANCE_TYPE=m8i.xlarge
export NODE_COUNT=1

# --- Upstream amazon-eks-ami build inputs (see README Versions) --------------------------
# Pin the amazon-eks-ami ref you build from (a tag/commit that includes pod-isolation support).
# Re-verify the builder-enclave behavior and the default instance type against this ref.
export EKS_AMI_REF=
# Firecracker is installed by the build; default "latest", floored at v1.18.0. Pin if you want.
export POD_ISOLATION_FIRECRACKER_VERSION=latest

# --- Waits (seconds) ----------------------------------------------------------------------
export AMI_WAIT_SECONDS=7200
