# Local configuration for the ubuntu-ami sample. Copy this file to config.env (gitignored;
# see .gitignore) and fill in real values there. Never commit config.env, and never put a
# real account ID, AMI ID, key, token, cluster/host name or internal URL in THIS file: it is
# tracked, and placeholders are all it should ever carry.
#
# Standard workstation environment (shared with the rest of this repository):
#   AWS_REGION, AWS_PROFILE, CLUSTER_NAME, and a kubectl context for the same cluster.

# --- Cluster and placement -------------------------------------------------------------
export AWS_REGION=us-west-2
export CLUSTER_NAME=nitro-sandboxes-demo
export KUBERNETES_VERSION=1.36
# Name the cluster you mean: pin the context for this shell, never `kubectl config use-context`.
# export KUBECTL="kubectl --context <your-context>"
# Existing private subnets in the cluster's VPC, with egress to package repositories, image
# registries, kernel.org, github.com, S3, SSM and EKS/EC2 APIs. This sample creates no network
# infrastructure.
export BUILD_SUBNET_ID=
export NODE_SUBNET_IDS=""          # space-separated
# The managed vpc-cni add-on version you installed as a prerequisite (see the README); recorded
# in the run evidence. scripts/00c-check-cluster.sh prints it in the install command it suggests.
export VPC_CNI_ADDON_VERSION=

# --- Ownership and naming ---------------------------------------------------------------
# Every AWS resource this sample creates is tagged ManagedBy=<RESOURCE_PREFIX>. clean.sh
# refuses to touch anything that does not carry this tag.
export RESOURCE_PREFIX=ubuntu-ami-sample
export NAMESPACE=ubuntu-ami-sample
export NODEGROUP_NAME=                # derived from RESOURCE_PREFIX when empty

# --- Build host and node instance types --------------------------------------------------
# The GA bundle's kernel build was validated on m8i.4xlarge; on m8i.xlarge the compile takes
# about four times as long.
export BUILD_INSTANCE_TYPE=m8i.4xlarge
export BUILD_ROOT_VOLUME_GB=120
export VERIFY_INSTANCE_TYPE=m8i.xlarge
export NODE_INSTANCE_TYPE=m8i.xlarge
export NODE_COUNT=1

# --- Pinned input versions (see packages/sources.lock and packages/SOURCES.txt) ---------------
export BASE_AMI_K8S_VERSION=1.36
export KERNEL_VERSION=6.18.56
export EROFS_UTILS_VERSION=1.8.10

# --- The Nitro sandbox runtime archive (operator-supplied; preview) --------------------------
# Obtain nitro-sandbox-binaries-2026-10-28.zip from your AWS account team while Nitro sandboxes
# are in preview, and place it in RUNTIME_ARTIFACTS_DIR. setup.sh's preflight verifies it
# against packages/sources.lock and STOPS with the documented prerequisite when it is absent.
# All local runtime state (logs, output, downloaded inputs) defaults via scripts/lib/common.sh
# under the repository's gitignored tmp/issue10/run (logs/, out/, runtime/). Override only with
# an ABSOLUTE path outside this sample folder: common.sh refuses any value under examples/.
export RUNTIME_ARTIFACT_FILE=nitro-sandbox-binaries-2026-10-28.zip
# export RUNTIME_ARTIFACTS_DIR=/absolute/path/outside/the/sample
# export LOG_DIR=/absolute/path/outside/the/sample/logs
# export OUT_DIR=/absolute/path/outside/the/sample/out

# --- Behavior flags -----------------------------------------------------------------------
# false is the production setting: enclaves attest their real measurements. true gives
# debug-mode enclaves (attestation PCRs read zero), for troubleshooting a node only.
export SHIM_DEBUG=false
