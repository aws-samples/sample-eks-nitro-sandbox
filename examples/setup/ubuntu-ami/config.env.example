# Local configuration for the ubuntu-ami sample. Copy this file to config.env (gitignored;
# see .gitignore) and fill in real values there. Never commit config.env, and never put a
# real account ID, AMI ID, key, token, cluster/host name or internal URL in THIS file: it is
# tracked, and placeholders are all it should ever carry.
#
# Standard workstation environment (shared with the rest of this repository):
#   AWS_REGION, AWS_PROFILE, CLUSTER_NAME, and KUBE_CONTEXT, the kubectl context of that cluster.

# --- Cluster and placement -------------------------------------------------------------
export AWS_REGION=us-west-2
export CLUSTER_NAME=nitro-sandboxes-demo
export KUBERNETES_VERSION=1.36
# Required: the kubectl context of CLUSTER_NAME (see `kubectl config get-contexts`). Every kubectl
# call passes --context "$KUBE_CONTEXT"; the scripts never fall back to the current context, never
# run `kubectl config use-context`, and stop unless this context's server is CLUSTER_NAME's API
# endpoint (aws eks describe-cluster).
export KUBE_CONTEXT=<your-context>
# Existing private subnets in the cluster's VPC, with egress to package repositories, image
# registries, kernel.org, github.com, S3, SSM and EKS/EC2 APIs. This sample creates no network
# infrastructure.
export BUILD_SUBNET_ID=
export NODE_SUBNET_IDS=""          # space-separated
# The managed vpc-cni add-on version you installed as a prerequisite (see the README); recorded
# in the run evidence. scripts/00c-check-cluster.sh prints it in the install command it suggests.
export VPC_CNI_ADDON_VERSION=

# --- Ownership and naming ---------------------------------------------------------------
# Every AWS resource a run creates is named <RESOURCE_PREFIX>-<RUN_ID>-... and tagged
# ManagedBy=<RESOURCE_PREFIX> and RunId=<RUN_ID>. setup.sh picks the run id (a UTC timestamp and
# random hex) and records it in tmp/issue10/run/out/run-state.env; clean.sh deletes only what carries both
# tags of the run it is given. Keep RESOURCE_PREFIX short: the derived names must fit the IAM
# (64) and EKS node group (63) limits, and setup.sh stops when one does not.
export RESOURCE_PREFIX=ubuntu-ami-sample
export NAMESPACE=ubuntu-ami-sample
# export RUN_ID=<run-id>             # only to resume or clean a run you already started

# --- Build host and node instance types --------------------------------------------------
# The GA bundle's kernel build was validated on m8i.4xlarge; on m8i.xlarge the compile takes
# about four times as long.
export BUILD_INSTANCE_TYPE=m8i.4xlarge
export BUILD_ROOT_VOLUME_GB=120
export VERIFY_INSTANCE_TYPE=m8i.xlarge
export NODE_INSTANCE_TYPE=m8i.xlarge
export NODE_COUNT=1

# --- Pinned input versions (see packages/sources.lock and packages/SOURCES.txt) ---------------
export BASE_AMI_K8S_VERSION=1.36
export KERNEL_VERSION=6.18.56
export EROFS_UTILS_VERSION=1.8.10

# --- The Nitro sandbox runtime archive: an operator-supplied preview archive, checksum-pinned, with no public download ---
# Obtain nitro-sandbox-binaries-2026-10-28.zip from your AWS account team and place it in
# RUNTIME_ARTIFACTS_DIR. setup.sh's preflight verifies it
# against packages/sources.lock and STOPS with the documented prerequisite when it is absent.
# All local runtime state (logs, output, downloaded inputs) defaults via scripts/lib/common.sh
# under the repository's gitignored tmp/issue10/run (logs/, out/, runtime/). An override must
# resolve under the repository's tmp/ (a relative one is read from this sample folder):
# common.sh refuses anything else, outside the repository included, and creates nothing then.
export RUNTIME_ARTIFACT_FILE=nitro-sandbox-binaries-2026-10-28.zip
# export RUNTIME_ARTIFACTS_DIR=<repository>/tmp/<your-dir>/runtime
# export LOG_DIR=<repository>/tmp/<your-dir>/logs
# export OUT_DIR=<repository>/tmp/<your-dir>/out

# --- Waits (seconds; scripts/lib/aws-wait.sh) ---------------------------------------------
# How long setup.sh waits for a new AMI to become available. The AWS CLI waiter stops after
# 600 s, and this sample's 120 GiB AMI took about 55 minutes; failed, error or this deadline
# stops the run.
export AMI_WAIT_SECONDS=7200
# How long the build host may take, after the reboot, to answer with a new boot id and the new
# kernel release.
# export REBOOT_WAIT_SECONDS=1200

# --- Behavior flags -----------------------------------------------------------------------
# false is the production setting: enclaves attest their real measurements. true gives
# debug-mode enclaves (attestation PCRs read zero), for troubleshooting a node only.
export SHIM_DEBUG=false
