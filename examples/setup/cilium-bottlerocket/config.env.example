# Settings for the Cilium on Bottlerocket sample. This file is tracked and holds placeholders
# and shared defaults only.
#
# Copy it to config.local.env (gitignored) and put your values there:
#
#   cp config.env.example config.local.env
#
# setup.sh, test.sh and clean.sh read this file first and config.local.env second, so a value
# in config.local.env wins. Never put credentials in either file. The scripts use the AWS
# profile of your shell (AWS_PROFILE), with short-lived credentials.

# The account and the Region of the new cluster. The scripts stop when the caller is in a
# different account. The sample is tested in us-west-2 only.
AWS_ACCOUNT_ID=""
AWS_REGION="us-west-2"

# The new cluster. The sample always creates its own cluster and never changes a cluster that
# it did not create. 3 to 32 characters: lowercase letters, digits and hyphens.
CLUSTER_NAME="nitro-cilium-bottlerocket"

# Two Availability Zones for the new VPC. Both node groups and the AMI builder use the FIRST
# zone. If a node group reports InsufficientInstanceCapacity, put another zone first.
AVAILABILITY_ZONES="us-west-2b us-west-2c"

# Instance types. The sandbox node must support Nitro Enclaves (m8i.xlarge does; the .large
# sizes do not). Check a type with:
#   aws ec2 describe-instance-types --instance-types <type> --query 'InstanceTypes[].NitroEnclavesSupport'
SYSTEM_INSTANCE_TYPE="m8i.xlarge"
SANDBOX_INSTANCE_TYPE="m8i.xlarge"
BUILD_INSTANCE_TYPE="m8i.4xlarge"

# The work volume of the AMI builder, in GiB, and the time that Packer waits for the AMI.
BUILD_WORK_VOLUME_GIB="150"
AMI_WAIT_SECONDS="3600"

# The sandbox slot count. This one value sets max-pods on the sandbox node and pcie_slots in the
# runtime configuration of the AMI. The AMI records it in its SandboxSlots tag. setup.sh stops
# when the AMI, the launch template or the node shows a different value.
SANDBOX_SLOTS="58"

# max-pods on the system node. Bottlerocket needs an explicit value with a CNI other than the
# Amazon VPC CNI.
SYSTEM_MAX_PODS="58"

# The size of the data volume (/dev/xvdb) of each node, in GiB.
SYSTEM_DATA_VOLUME_GIB="30"
SANDBOX_DATA_VOLUME_GIB="80"

# The stock Bottlerocket aws-k8s-1.36 v1.70.0 AMI for the system node. Leave it empty: setup.sh
# reads the ID from the public SSM parameter
# /aws/service/bottlerocket/aws-k8s-1.36/x86_64/1.70.0/image_id, checks the image, and writes
# the ID into config.local.env, so that each later run uses the same AMI.
SYSTEM_AMI_ID=""

# Optional. An AMI that an earlier run of this sample built. setup.sh uses it instead of a new
# build only when it carries ManagedBy=cilium-bottlerocket-sample, the same SandboxSlots value,
# and passes the AMI checks.
REUSE_SANDBOX_AMI_ID=""
