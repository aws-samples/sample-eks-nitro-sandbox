# Copy to .env (git ignores it) and fill in. Never commit the real file.
#
#   cp .env.example .env && $EDITOR .env
#
# Every script in scripts/ reads this file. Nothing in it is a secret: the GitLab root
# password and the runner authentication token are generated by the scripts, kept in
# Kubernetes Secrets, and never written here.

# The kube context to run against, named on every kubectl call so a context another session
# changes cannot redirect the run.
KUBE_CONTEXT=sandbox-demo

# The namespace this sample owns. It is created if it is absent and labelled
# ManagedBy=gitlab-ci; a namespace that exists without that label is refused, because it is
# someone else's.
NAMESPACE=gitlab-ci-demo

# Optional overrides, if a default name is taken on a shared cluster:
# RUNNER_SECRET=gitlab-runner-config
# ROOT_SECRET=gitlab-root
# PROJECT_PATH=sandbox-ci
# STORAGE_CLASS=            # the cluster's default EBS class is used when this is empty
