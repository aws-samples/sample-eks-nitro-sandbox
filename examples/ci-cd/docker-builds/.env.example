# Copy to .env (git ignores it) and fill in. Never commit the real file.
# Only the optional Amazon ECR push needs it: scripts/ecr-setup.sh and scripts/clean.sh read
# it. scripts/setup.sh and the build Jobs need no local values at all.

# The EKS cluster to run on, and its Region. The cluster must have the isolated-sandbox
# runtime class (see the Getting started samples).
CLUSTER_NAME=sandbox-demo
AWS_REGION=us-west-2

# Optional overrides, if the default names are taken on a shared account:
# ECR_REPO_NAME=nitro-sample-docker-builds
# ROLE_NAME=nitro-sample-docker-builds-push

# NAMESPACE does not belong here: every script takes it from the environment, as the page's
# `export NAMESPACE=...` does, and only this file's reader would see it here.
