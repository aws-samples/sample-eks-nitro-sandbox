# Copy to .env (which git ignores) and fill in. scripts/setup.sh and
# scripts/clean.sh read these. No value here is a secret: the credential itself
# stays in a file of your own, and only its path goes below.

# The cluster to run against. Both scripts pin the kube context to this name, so
# a context someone else changes cannot redirect the run.
CLUSTER_NAME=

# The repository the runners register with, which you own and can afford to run
# untrusted-shaped jobs in. A repository-scoped runner set needs the repository
# URL; an organization-scoped one needs the organization URL.
#   https://github.com/<OWNER>/<TEST_REPO>
GITHUB_CONFIG_URL=

# --- the credential: supply EITHER a GitHub App (recommended) OR a token ---
#
# A GitHub App is least-privilege and rotates its own tokens. For a
# repository-scoped runner set it needs Administration: read and write, and
# Metadata: read-only. For an organization-scoped set it needs Self-hosted
# runners: read and write instead of Administration. Install it on the one test
# repository, not on every repository in the account.
#
# GITHUB_APP_PRIVATE_KEY_FILE is the .pem file GitHub gave you when you
# generated the App's private key. setup.sh reads it as a file, so the key never
# appears on a command line.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=

# Or a fine-grained personal access token whose Repository access is only the
# one test repository, with Administration: read and write and Metadata:
# read-only. Put the token in a file by itself, with nothing else in it, and
# give the path here. Do not paste the token into this file.
#   printf '%s' 'github_pat_...' > ~/.github-arc-token && chmod 600 ~/.github-arc-token
GITHUB_PAT_FILE=

# --- names and versions; the defaults match the sample's page ---

# Both ARC charts must be the same version: the controller refuses a scale set
# built by a different one.
ARC_VERSION=0.15.1

# The controller and the runners go in different namespaces, which is GitHub's
# documented practice. The listener pod runs in the controller's namespace.
ARC_SYSTEMS_NAMESPACE=arc-systems
ARC_RUNNERS_NAMESPACE=arc-runners

# The Helm release name of the runner scale set. A workflow reaches it with
# `runs-on: <this value>`, so changing it means changing the workflow too.
RUNNER_SCALE_SET_NAME=github-actions-nitro

# The Secret scripts/setup.sh creates from your credential file, and that the
# Helm values reference by name.
GITHUB_SECRET_NAME=github-credential
