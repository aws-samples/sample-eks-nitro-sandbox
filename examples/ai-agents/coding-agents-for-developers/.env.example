# Copy to .env (which git ignores) and fill in. setup.sh reads these and records the
# resource ids it creates back into .env. No value here is a secret.

# Your cluster and Region.
CLUSTER_NAME=
AWS_REGION=us-west-2

# The Kubernetes namespace the sample runs in. Override to run it under another name.
NAMESPACE=coding-agents-for-developers

# The S3 bucket setup.sh creates for the S3 Files file system. Leave blank to let
# setup.sh name it for the sample, account and Region.
S3_BUCKET_NAME=

# The prefix inside the bucket that the S3 Files file system is rooted at. Each session
# folder lives under <developer>/<cli>/<session> below this.
S3_PREFIX=coding-agents

# The tag setup.sh builds and deploys the images under. The pods use
# imagePullPolicy: IfNotPresent, so after changing an image set a new tag (v2, ...) and
# run setup.sh again; a node that already pulled a tag keeps its cached copy.
IMAGE_TAG=v1

# Filled in by setup.sh; do not set by hand.
ACCOUNT_ID=
S3_FILES_FS_ID=
