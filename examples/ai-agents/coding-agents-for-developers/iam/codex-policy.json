{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockMantleForCodex",
      "Effect": "Allow",
      "Action": [
        "bedrock-mantle:CreateInference"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WebSearchToolsForCodex",
      "Effect": "Allow",
      "Action": [
        "bedrock-websearch:InvokeSearch",
        "bedrock-websearch:InvokeFetch"
      ],
      "Resource": "arn:aws:bedrock-websearch:<AWS_REGION>:aws:tool/*"
    },
    {
      "Sid": "WebSearchExternalAccessForCodex",
      "Effect": "Allow",
      "Action": [
        "bedrock-websearch:ExternalWebAccess"
      ],
      "Resource": "*"
    }
  ]
}
