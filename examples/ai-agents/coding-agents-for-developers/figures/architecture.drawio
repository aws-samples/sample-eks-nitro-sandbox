<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device">
  <diagram id="coding-agents-for-developers" name="Diagram">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1320" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Developer, outside AWS -->
        <mxCell id="developer" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;Developer&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;browser, kubectl port-forward&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;spacing=0;fontSize=24;fontColor=#232F3E;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- AWS Cloud -->
        <mxCell id="cloud" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;AWS Cloud&lt;/div&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;grStroke=1;grIconSize=48;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=62;spacingTop=6.417;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="320" y="60" width="2000" height="1240" as="geometry" />
        </mxCell>

        <!-- EKS cluster -->
        <mxCell id="cluster" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Amazon EKS cluster&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#ED7100;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=62;spacingTop=6.417;fontSize=14;fontStyle=1;fontColor=#ED7100;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="360" y="160" width="1180" height="920" as="geometry" />
        </mxCell>
        <mxCell id="tab-cluster" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="1">
          <mxGeometry x="360" y="160" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- Web app pod (ordinary) -->
        <mxCell id="app" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Web app&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:22px&quot;&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;ordinary pod, trusted first-party&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="420" y="520" width="340" height="300" as="geometry" />
        </mxCell>
        <mxCell id="app-icon" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;claims a pod,&lt;/div&gt;&lt;div style=&quot;line-height:28.80px&quot;&gt;drives the terminal&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_application;fontSize=22;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="550" y="590" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Warm pool (controller-owned), holding the session pod -->
        <mxCell id="pool-frame" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;SandboxWarmPool (per CLI)&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#7D8998;fillColor=none;strokeWidth=2;dashed=1;dashPattern=8 5;fixDash=1;verticalAlign=top;align=left;spacing=0;spacingLeft=16;spacingTop=6.417;fontSize=14;fontStyle=1;fontColor=#5A6B86;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="900" y="420" width="580" height="500" as="geometry" />
        </mxCell>

        <!-- Nitro sandbox pod (the claimed session pod) -->
        <mxCell id="sandbox" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Nitro sandbox pod&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:22px&quot;&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;isolated-sandbox, one per session&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#DD344C;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=62;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#DD344C;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="960" y="500" width="460" height="360" as="geometry" />
        </mxCell>
        <mxCell id="tab-sandbox" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1">
          <mxGeometry x="960" y="500" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="sandbox-icon" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;tmux + the CLI,&lt;/div&gt;&lt;div style=&quot;line-height:28.80px&quot;&gt;session-bridge on 7681,&lt;/div&gt;&lt;div style=&quot;line-height:28.80px&quot;&gt;workspace at /workspace&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_application;fontSize=22;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1110" y="600" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- S3 Files access point (right column, well separated) -->
        <mxCell id="s3files" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;S3 Files access point&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;per running session&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_file_system;spacing=0;fontSize=24;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1960" y="220" width="80" height="80" as="geometry" />
        </mxCell>
        <!-- S3 bucket -->
        <mxCell id="bucket" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;S3 bucket&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;one prefix per session&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;spacing=0;fontSize=24;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1960" y="500" width="80" height="80" as="geometry" />
        </mxCell>
        <!-- Amazon Bedrock -->
        <mxCell id="bedrock" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;Amazon Bedrock&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;invoke models&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;Codex: also web search&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;spacing=0;fontSize=24;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1960" y="820" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Refused destinations, bottom, outside the cluster -->
        <mxCell id="internet" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;Other hosts, other pods&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;&lt;i&gt;&lt;span style=&quot;color:#5F6B7A&quot;&gt;refused&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_alt1;spacing=0;fontSize=24;fontStyle=0;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1150" y="1160" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Edges. Each label carries an explicit offset so it sits beside the line. -->
        <!-- developer -> app -->
        <mxCell id="e-dev-app" value="terminal over&lt;br&gt;port-forward" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="developer" target="app">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-50" y="-30" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- app -> sandbox -->
        <mxCell id="e-app-sandbox" value="claim, then mount with&lt;br&gt;a per-session credential" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.4722;" edge="1" parent="1" source="app" target="sandbox">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-30" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- app -> sandbox's session-bridge, over the pod network (y=770 on both boxes) -->
        <mxCell id="e-app-bridge" value="terminal (TLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;exitX=1;exitY=0.8333;entryX=0;entryY=0.75;" edge="1" parent="1" source="app" target="sandbox">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-30" y="-18" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- sandbox -> s3files -->
        <mxCell id="e-sandbox-s3files" value="mount own&lt;br&gt;access point only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="sandbox" target="s3files">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1770" y="572" /><mxPoint x="1770" y="260" /></Array>
            <mxPoint x="-115" y="40" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- s3files <-> bucket (sync), routed down the right side clear of the labels -->
        <mxCell id="e-s3files-bucket" value="sync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;align=left;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s3files" target="bucket">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="2120" y="260" /><mxPoint x="2120" y="540" /></Array>
            <mxPoint x="12" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- sandbox -> bedrock -->
        <mxCell id="e-sandbox-bedrock" value="invoke models (Pod Identity)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="sandbox" target="bedrock">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1760" y="788" /><mxPoint x="1760" y="860" /></Array>
            <mxPoint x="0" y="-18" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- sandbox -> internet (refused) -->
        <mxCell id="e-sandbox-internet" value="refused by the egress policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DD344C;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;fontSize=18;fontStyle=2;fontColor=#DD344C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;align=left;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sandbox" target="internet">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="12" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
